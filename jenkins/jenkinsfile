pipeline {

    agent any

    stages{

        stage('build'){
            steps{
                sh 'echo "am buiding the image in the docker" '
            }
        }

        stage('test'){
            steps{
                sh 'echo "am testing the image in the docker" '
            }
        }
        stage('Deploy'){
            steps{
                sh 'echo "am deploying the image in the kubernetes" '
            }
        }
        stage('CPU'){
            steps{
                sh '''
                
                lscpu

                '''
            }

        }
    }

}
